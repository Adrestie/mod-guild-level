#
# mod-guild-level — configuration
#
# Members of one guild who kill monsters together earn guild experience. The
# guild climbs 25 levels, then Paragon levels (GuildLevel.Paragon.Max).
#
# Every value below is also the built-in default, so a setting left out changes
# nothing. Reloaded by `.reload config`.
#
# Copy this file to your configs/modules directory and drop the .dist extension.
#

[worldserver]

###############################################################################
#
#    GuildLevel.Enable
#        0 = no guild earns experience. Levels already reached are kept, and
#        the GM commands still work.
#

GuildLevel.Enable               = 1

###############################################################################
#
#    EXPERIENCE
#
#    When a monster dies, every member of the group it rewards (the killer and
#    the members within reward distance, alive) who belongs to the killer's
#    guild brings the guild the experience the kill is worth to him alone: not
#    split by the group, before any personal bonus, the server's kill rate
#    included. Three guildmates killing a monster worth 100 experience each
#    bring the guild 300. A monster gray to a member brings nothing from him.
#
#    GuildLevel.MinMembers
#        Guildmates the group needs at the kill before the guild earns
#        anything. 2 = two members of the same guild at least. 1 lets a member
#        playing alone earn for his guild.
#
#    GuildLevel.Rate
#        Multiplies everything the guild earns. Decimals are allowed.
#

GuildLevel.MinMembers           = 2
GuildLevel.Rate                 = 1.0

###############################################################################
#
#    QUESTS AND CONTENT
#
#    GuildLevel.Quest.Rate
#        A quest completed by a member brings his guild the quest's experience
#        at his level (also at the maximum level, where the quest pays gold)
#        times this, then times GuildLevel.Rate. A level 80 quest is worth
#        about 20,000 to 30,000: 0.1 brings about 2,500.
#
#    GuildLevel.Content.<family>
#        A creature killed brings this much MORE than its own experience, per
#        guildmate present (alive, within reward distance, in the killer's
#        group), then times GuildLevel.Rate, to every guild with
#        GuildLevel.MinMembers present. Gray creatures count too. The families
#        follow DynamicLoot's (same names, same rules, built into the module):
#          ...World, ...Rare, ...WorldBoss    outside dungeons and raids (a BC
#                                             map's creature below level 57 is
#                                             Vanilla's)
#          ...DungeonTrash, ...DungeonBoss    dungeons (WotLK: normal mode)
#          WotlkHeroicTrash, WotlkHeroicBoss  WotLK dungeons in heroic mode
#          ...RaidTrash, ...RaidBoss          raids (WotLK: outside Icecrown)
#          IcecrownRaidTrash, IcecrownRaidBoss
#        A family left out gives nothing more.
#

GuildLevel.Quest.Rate                  = 0.1
GuildLevel.Content.VanillaWorld        = 0
GuildLevel.Content.VanillaRare         = 0
GuildLevel.Content.VanillaWorldBoss    = 0
GuildLevel.Content.VanillaDungeonTrash = 0
GuildLevel.Content.VanillaDungeonBoss  = 1000
GuildLevel.Content.VanillaRaidTrash    = 0
GuildLevel.Content.VanillaRaidBoss     = 5000
GuildLevel.Content.BcWorld             = 0
GuildLevel.Content.BcRare              = 0
GuildLevel.Content.BcWorldBoss         = 0
GuildLevel.Content.BcDungeonTrash      = 0
GuildLevel.Content.BcDungeonBoss       = 2000
GuildLevel.Content.BcRaidTrash         = 0
GuildLevel.Content.BcRaidBoss          = 10000
GuildLevel.Content.WotlkWorld          = 0
GuildLevel.Content.WotlkRare           = 0
GuildLevel.Content.WotlkWorldBoss      = 0
GuildLevel.Content.WotlkDungeonTrash   = 0
GuildLevel.Content.WotlkDungeonBoss    = 3000
GuildLevel.Content.WotlkHeroicTrash    = 0
GuildLevel.Content.WotlkHeroicBoss     = 5000
GuildLevel.Content.WotlkRaidTrash      = 0
GuildLevel.Content.WotlkRaidBoss       = 15000
GuildLevel.Content.IcecrownRaidTrash   = 0
GuildLevel.Content.IcecrownRaidBoss    = 25000

###############################################################################
#
#    CURVES
#
#    The experience each step costs, separated by spaces or commas. The bar
#    starts again from zero at each step, and what is left over goes on to
#    the next one.
#
#    GuildLevel.Curve.Levels
#        25 amounts: the first takes a new guild (level 0) to level 1, the last
#        takes level 24 to level 25.
#
#    GuildLevel.Paragon.Max
#        The last Paragon level, past level 25 (1 to 255). It is the end: the
#        guild earns nothing more (its lifetime total still counts). A guild
#        above a lowered maximum comes down to it.
#
#    GuildLevel.Curve.Paragon
#        One amount per Paragon level: the first takes the guild to Paragon 1,
#        the next to Paragon 2, and so on.
#
#    A shorter list repeats its last amount; extra amounts are ignored. For
#    scale: a level 80 monster is worth about 500 experience to a level 80
#    character, so five guildmates bring their guild about 2,500 per kill. With
#    these curves, level 25 takes about 11 million experience in all,
#    Paragon 9 another 23 million, and each Paragon level after it 4 million.
#

GuildLevel.Curve.Levels         = "20000 30000 45000 60000 80000 100000 125000 150000 180000 210000 250000 290000 330000 380000 430000 490000 550000 620000 700000 780000 870000 960000 1060000 1170000 1300000"
GuildLevel.Paragon.Max          = 99
GuildLevel.Curve.Paragon        = "1500000 1750000 2000000 2250000 2500000 2750000 3000000 3500000 4000000"

###############################################################################
#
#    GuildLevel.Announce
#        Each level and Paragon level reached is told to every member of the
#        guild online, in the green of the guild channel, in his language.
#
#    GuildLevel.SaveInterval
#        Seconds between two writes of the guilds' experience to the database.
#        A level reached is written at once, and everything on shutdown.
#

GuildLevel.Announce             = 1
GuildLevel.SaveInterval         = 10

###############################################################################
#
#    PERKS OF LEVELS 1 TO 20
#
#    Every member of a guild gets the perks of its current level, alone or in
#    a group, from the moment the level is reached or the member joins.
#
#    GuildLevel.Perks.Enable
#        0 = no perk at all (the levels still climb).
#
#    Each perk below is a list of steps "level:amount", separated by spaces or
#    commas. The steps the guild has reached add up: "1:5 11:10" is +5 from
#    level 1 and +15 from level 11. "" turns the perk off.
#
#    GuildLevel.Perk.Experience      % more experience, from every source.
#    GuildLevel.Perk.Durability      damaged pieces worn mended by 1 point of
#                                    durability every period, each a different
#                                    piece drawn at random.
#    GuildLevel.Perk.Durability.Interval
#                                    seconds between two mendings.
#    GuildLevel.Perk.Honor           % more honor, from every source.
#    GuildLevel.Perk.Hearthstone     minutes off the Hearthstone cooldown.
#    GuildLevel.Perk.Gathering       items more on a lucky mining, herbalism or
#                                    skinning, of the first item taken.
#    GuildLevel.Perk.Gathering.Chance
#                                    % chance of a lucky gathering.
#    GuildLevel.Perk.Vendor          % off the prices of vendors and repairs
#                                    (not trainers, not flight masters).
#    GuildLevel.Perk.GoldToBank      % of the gold looted from creatures and
#                                    chests ADDED to the guild bank; the
#                                    looters keep all of theirs.
#    GuildLevel.Perk.MountSpeed      % more mounted speed, ground and flying.
#    GuildLevel.Perk.Reputation      % more reputation (gains only).
#    GuildLevel.Perk.Resurrection    above 0: resurrected by a member of the
#                                    guild, a player comes back with full
#                                    health and mana.
#    GuildLevel.Perk.Consumables     minutes added to flasks, elixirs and food
#                                    buffs ("Well Fed").
#

GuildLevel.Perks.Enable           = 1
GuildLevel.Perk.Experience        = "1:5 11:10"
GuildLevel.Perk.Durability        = "2:1 12:1"
GuildLevel.Perk.Durability.Interval = 60
GuildLevel.Perk.Honor             = "3:5 13:10"
GuildLevel.Perk.Hearthstone       = "4:5 14:10"
GuildLevel.Perk.Gathering         = "5:1 15:2"
GuildLevel.Perk.Gathering.Chance  = 10
GuildLevel.Perk.Vendor            = "6:5 16:5"
GuildLevel.Perk.GoldToBank        = "7:5 17:5"
GuildLevel.Perk.MountSpeed        = "8:5 18:5"
GuildLevel.Perk.Reputation        = "9:5 19:5"
GuildLevel.Perk.Resurrection      = "10:1"
GuildLevel.Perk.Consumables       = "20:30"

###############################################################################
#
#    ACTIVE PERKS OF LEVELS 21 TO 25
#
#    Player commands `.gperk raid|rez|bank|vendor|home` (and `.gperk list`),
#    for the members of a guild of the level asked. Each perk has its own
#    cooldown per character, kept in the characters database across restarts.
#    A perk that does nothing (no one to summon, no one dead...) starts no
#    cooldown. GuildLevel.Perks.Enable = 0 turns them off too.
#
#    GuildLevel.Active.<Perk>.Level      guild level the perk needs.
#    GuildLevel.Active.<Perk>.Cooldown   seconds; 0 = no cooldown.
#
#    Raid    summons every member of the group, who accepts as with a summoning
#            stone. Out of combat, not in a battleground or an arena.
#    Rez     offers a resurrection to the dead of the group on the same map,
#            out of combat, with GuildLevel.Active.Rez.Percent of their health
#            and mana (the level 10 perk makes it full for guildmates).
#    Bank    a Guild Chest in front of the player for .Duration seconds:
#            Cataclysm's Mobile Banking chest, converted for 3.3.5a, with a
#            blue banner for the Alliance (.Entry.Alliance, 920000) and a red
#            one for the Horde (.Entry.Horde, 920001). Any gameobject of the
#            guild bank type does: 187294 is the game's own Guild Vault.
#    Vendor  a reagent vendor and repairer in front of the player for
#            .Duration seconds (.Entry: creature 92001 of the module).
#    Home    into the guild house, once the guild has one (Paragon 1, see
#            THE GUILD HOUSE below); without it, no cooldown starts.
#

GuildLevel.Active.Raid.Level        = 21
GuildLevel.Active.Raid.Cooldown     = 3600
GuildLevel.Active.Rez.Level         = 22
GuildLevel.Active.Rez.Cooldown      = 600
GuildLevel.Active.Rez.Percent       = 35
GuildLevel.Active.Bank.Level        = 23
GuildLevel.Active.Bank.Cooldown     = 3600
GuildLevel.Active.Bank.Duration     = 300
GuildLevel.Active.Bank.Entry.Alliance = 920000
GuildLevel.Active.Bank.Entry.Horde  = 920001
GuildLevel.Active.Vendor.Level      = 24
GuildLevel.Active.Vendor.Cooldown   = 3600
GuildLevel.Active.Vendor.Duration   = 300
GuildLevel.Active.Vendor.Entry      = 92001
GuildLevel.Active.Home.Level        = 25
GuildLevel.Active.Home.Cooldown     = 0

###############################################################################
#
#    THE GUILD HOUSE (PARAGON 1 AND UP)
#
#    Champions' Hall (map 449) for the Alliance, the Hall of Legends (map 450)
#    for the Horde: every guild has its own house, in one of the hall's 31
#    phases while it is open (the core cannot give a guild its own instance:
#    it refuses a second player who is not in the first one's group). Up to
#    31 houses open at once per hall; any number of guilds in all.
#    `.gperk home` goes in (guild level 25), `.gperk leave` goes back.
#    What stands in a house is in the world table mod_guild_level_house_spawn,
#    Paragon level by Paragon level.
#
#    GuildLevel.House.Enable       0 = no guild house.
#    GuildLevel.House.Paragon      the Paragon level that opens the house.
#    GuildLevel.House.EmptyDelay   seconds an empty house keeps its phase
#                                  before it goes back to the pool.
#

GuildLevel.House.Enable           = 1
GuildLevel.House.Paragon          = 1
GuildLevel.House.EmptyDelay       = 60

###############################################################################
#
#    THE CUSTOMIZATION MODE
#
#    The guild decorates its house with the objects it owns (mod_guild_level_decor,
#    world; .ghouse give fills a guild's stock), each placed at most as many
#    times as it is owned. The members' client needs WarcraftXL with the
#    guild house editor (Extensions/wxl-guildhouse) and wxl-modern-m2.
#
#    GuildLevel.House.Decor.Enable    0 = no Customization.
#    GuildLevel.House.Decor.Paragon   the Paragon level that opens it.
#    GuildLevel.House.Decor.Rank      the highest guild rank id allowed to
#                                     decorate: 0 the guild master only, 1
#                                     the officers too, and so on.
#    GuildLevel.House.Decor.DropChance  % for a dungeon or raid boss to drop
#                                     an object for a guild there in numbers
#                                     (only its members see it in the loot).
#    GuildLevel.House.Decor.ThemeChance  % for that object to be one of the
#                                     instance's theme (tools/decor/loot.json);
#                                     else one of the objects of no theme, which
#                                     every instance drops.
#    GuildLevel.House.Decor.Members.Dungeon  guildmates needed at the kill in
#    GuildLevel.House.Decor.Members.Raid10   a dungeon, a 10-player raid and a
#    GuildLevel.House.Decor.Members.Raid25   25-player raid.
#

GuildLevel.House.Decor.Enable     = 1
GuildLevel.House.Decor.Paragon    = 9
GuildLevel.House.Decor.Rank       = 1
GuildLevel.House.Decor.DropChance = 10
GuildLevel.House.Decor.ThemeChance = 60
GuildLevel.House.Decor.Members.Dungeon = 4
GuildLevel.House.Decor.Members.Raid10  = 8
GuildLevel.House.Decor.Members.Raid25  = 20

###############################################################################
#
#    THE GUILD TALENTS
#
#    From level FromLevel, each level and each Paragon level gives the guild
#    PointsPerLevel talent points. The guild master and the officers spend
#    them in the talent tree (the button of the guild window, or .gtalent);
#    every member of the guild gets the effects.
#
#    GuildLevel.Talents.Enable          1: on, 0: no points, no effects.
#    GuildLevel.Talents.FromLevel       the first guild level that gives
#                                       points (1 to 25).
#    GuildLevel.Talents.PointsPerLevel  points per level and Paragon level.
#    GuildLevel.Talents.Rank            the members of guild rank 0 (the guild
#                                       master) to this one spend the points
#                                       and reset them: 1 = the officers.
#    GuildLevel.Talents.Tier2.Points    points the guild must have spent before
#    GuildLevel.Talents.Tier3.Points    a talent of tier 2, of tier 3, is bought.
#
#    A RESET gives every point back and costs gold from the guild bank:
#    GuildLevel.Talents.Reset.Cost      gold, the first time.
#    GuildLevel.Talents.Reset.Increase  % of that cost added by each reset.
#    GuildLevel.Talents.Reset.Decrease  % of that cost taken off each week
#                                       since the last reset, down to the cost.
#

GuildLevel.Talents.Enable          = 1
GuildLevel.Talents.FromLevel       = 10
GuildLevel.Talents.PointsPerLevel  = 1
GuildLevel.Talents.Rank            = 1
GuildLevel.Talents.Tier2.Points    = 10
GuildLevel.Talents.Tier3.Points    = 25
GuildLevel.Talents.Reset.Cost      = 5000
GuildLevel.Talents.Reset.Increase  = 10
GuildLevel.Talents.Reset.Decrease  = 10
